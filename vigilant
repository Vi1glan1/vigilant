return function(script_key)
    -- For executors supporting http_request (recommended)
    local headers = {
        ["User-Agent"] = "Vigilantxs1v1v15",
        ["X-User-ID"] = tostring(game.Players.LocalPlayer.UserId),
        ["X-Executor"] = identifyexecutor and identifyexecutor() or "Unknown",
        ["X-Game-ID"] = tostring(game.PlaceId)
    }
    local request = http_request or request or (syn and syn.request)
    if request then
        local response = request({
            Url = "https://vigilant-nine.vercel.app/script?key=" .. script_key,
            Method = "GET",
            Headers = headers
        })
        if response and response.StatusCode == 200 then
            loadstring(response.Body)()
        else
            game.Players.LocalPlayer:Kick(response and response.Body or "Failed to load script")
        end
    else
        -- Fallback for game:HttpGet (requires token)
        local token = "a4f9$D1vks#L@98g73kqplXzZ!VIGILANTA%^" -- Replace with token from bot
        loadstring(game:HttpGet("https://vigilant-nine.vercel.app/proxy?key=" .. script_key .. "&token=" .. token))()
    end
end
